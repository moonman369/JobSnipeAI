    "Execute 01 Ingestion": { "main": [[{ "node": "Execute 02 Apify", "type": "main", "index": 0 }]] },
    "Execute 02 Apify": { "main": [[{ "node": "Execute 03 Normalize+Track", "type": "main", "index": 0 }]] },
    "Execute 03 Normalize+Track": { "main": [[{ "node": "Execute 04 AI", "type": "main", "index": 0 }]] },
    "Execute 04 AI": { "main": [[{ "node": "Finalize Run", "type": "main", "index": 0 }]] },
    "Finalize Run": { "main": [[{ "node": "Write SummarizationRuns End", "type": "main", "index": 0 }]] }
