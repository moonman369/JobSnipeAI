N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Kolkata

# Google Sheets
GSHEET_JOB_CONFIGS_ID=your_job_config_spreadsheet_id
GSHEET_TRACKER_ID=your_tracker_spreadsheet_id

# Apify
APIFY_TOKEN=apify_api_token
APIFY_ACTOR_ID=zn01OAlzP853oqn4Z

# AI / OpenAI
OPENAI_API_KEY=openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4.1-mini
AI_MATCH_THRESHOLD=70

# Functional defaults
COUNTRY_FILTER_DEFAULT=IN
FORCE_REPROCESS=false
COLDMAIL_SALUTATION=[Name]

# Resume sources (store in Docker secrets or env file in prod)
RESUME_MASTER_PROFILE=Senior backend engineer with Java, Spring Boot, microservices, cloud and distributed systems experience.
RESUME_LATEX_FULL=Paste full LaTeX resume content here or fetch from a file in a pre-step.
